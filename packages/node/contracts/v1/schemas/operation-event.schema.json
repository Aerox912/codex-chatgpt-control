{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex-chatgpt-control/contracts/v1/schemas/operation-event.schema.json",
  "title": "Transactional browser operation event envelope",
  "description": "A checksummed append-only journal envelope. Event payloads contain only redacted identifiers, digests, counts, state transitions, and receipts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "previousEventDigest", "eventDigest", "event"],
  "properties": {
    "schemaVersion": { "const": "chatgpt.browser_control.operation_event.v1" },
    "revision": { "$ref": "#/$defs/revision" },
    "previousEventDigest": { "$ref": "#/$defs/digest" },
    "eventDigest": { "$ref": "#/$defs/digest" },
    "event": { "$ref": "#/$defs/event" }
  },
  "$defs": {
    "capturePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responseContent", "responseFormat", "artifacts"],
      "properties": {
        "responseContent": { "enum": ["include", "metadata"] },
        "responseFormat": { "enum": ["markdown", "text"] },
        "artifacts": { "enum": ["receipt_only", "transfer"] }
      }
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^hmac-sha256:[0-9a-f]{64}$"
    },
    "instant": {
      "type": "string",
      "pattern": "^(?!\\d{4}-02-(?:30|31)T)(?!\\d{4}-(?:04|06|09|11)-31T)\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]{1,512}$"
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "phase": {
      "enum": [
        "prepared",
        "handoff_pending",
        "ready",
        "send_pending",
        "submitted",
        "generating",
        "capturing",
        "completed",
        "uncertain"
      ]
    },
    "mutationBoundary": {
      "enum": ["none", "handoff_may_have_occurred", "send_may_have_occurred", "control_may_have_occurred"]
    },
    "evidenceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerIdentity",
        "stableTabId",
        "stableConversationId",
        "stableUserTurnId",
        "authoritativeTabClaim",
        "replacementTabRecovery"
      ],
      "properties": {
        "providerIdentity": { "enum": ["required", "unavailable"] },
        "stableTabId": { "enum": ["required", "unavailable"] },
        "stableConversationId": { "enum": ["required", "unavailable"] },
        "stableUserTurnId": { "enum": ["required", "unavailable"] },
        "authoritativeTabClaim": { "enum": ["required", "unavailable"] },
        "replacementTabRecovery": { "type": "boolean" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "browserId", "tabId", "coordinationScope", "evidenceProfile"],
      "properties": {
        "providerId": { "$ref": "#/$defs/opaqueId" },
        "browserId": { "$ref": "#/$defs/opaqueId" },
        "tabId": { "$ref": "#/$defs/opaqueId" },
        "coordinationScope": { "enum": ["process", "provider"] },
        "tabClaimEvidenceDigest": { "$ref": "#/$defs/digest" },
        "canonicalThreadUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^https://[^?#]+$"
        },
        "conversationId": { "$ref": "#/$defs/opaqueId" },
        "userTurnBaselineDigest": { "$ref": "#/$defs/digest" },
        "assistantTurnBaselineDigest": { "$ref": "#/$defs/digest" },
        "configurationReceiptDigest": { "$ref": "#/$defs/digest" },
        "targetLifecycle": { "enum": ["fixed", "new_pending", "new_established"] },
        "newTargetAnchorDigest": { "$ref": "#/$defs/digest" },
        "blankTaskEvidenceDigest": { "$ref": "#/$defs/digest" },
        "targetEstablishment": { "$ref": "#/$defs/targetEstablishmentRead" },
        "evidenceProfile": { "$ref": "#/$defs/evidenceProfile" }
      },
      "allOf": [
        {
          "if": { "properties": { "coordinationScope": { "const": "provider" } }, "required": ["coordinationScope"] },
          "then": {
            "required": ["tabClaimEvidenceDigest"],
            "properties": {
              "tabClaimEvidenceDigest": { "$ref": "#/$defs/digest" },
              "evidenceProfile": {
                "type": "object",
                "properties": { "authoritativeTabClaim": { "const": "required" } }
              }
            }
          }
        }
        ,{
          "if": { "type": "object", "properties": { "targetLifecycle": { "const": "new_pending" } }, "required": ["targetLifecycle"] },
          "then": {
            "type": "object",
            "required": ["newTargetAnchorDigest", "blankTaskEvidenceDigest"],
            "properties": {
              "newTargetAnchorDigest": { "$ref": "#/$defs/digest" },
              "blankTaskEvidenceDigest": { "$ref": "#/$defs/digest" }
            }
          }
        },
        {
          "if": { "type": "object", "properties": { "targetLifecycle": { "const": "new_established" } }, "required": ["targetLifecycle"] },
          "then": {
            "type": "object",
            "required": ["newTargetAnchorDigest", "blankTaskEvidenceDigest", "canonicalThreadUrl", "conversationId", "targetEstablishment"],
            "properties": {
              "newTargetAnchorDigest": { "$ref": "#/$defs/digest" },
              "blankTaskEvidenceDigest": { "$ref": "#/$defs/digest" },
              "canonicalThreadUrl": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^https://[^?#]+$" },
              "conversationId": { "$ref": "#/$defs/opaqueId" },
              "targetEstablishment": { "$ref": "#/$defs/targetEstablishment" }
            }
          }
        },
        {
          "if": { "type": "object", "properties": { "targetLifecycle": { "const": "fixed" } }, "required": ["targetLifecycle"] },
          "then": { "type": "object" }
        }
      ]
    },
    "targetEstablishmentRead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetBindingDigest",
        "anchorDigest",
        "causalSendActionId",
        "conversationId",
        "canonicalThreadUrl",
        "userTurnId",
        "userTurnEvidenceDigest",
        "evidenceDigest",
        "observedAt"
      ],
      "properties": {
        "targetBindingDigest": { "$ref": "#/$defs/digest" },
        "anchorDigest": { "$ref": "#/$defs/digest" },
        "causalSendActionId": { "$ref": "#/$defs/uuid" },
        "conversationId": { "$ref": "#/$defs/opaqueId" },
        "canonicalThreadUrl": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^https://[^?#]+$" },
        "userTurnId": { "$ref": "#/$defs/opaqueId" },
        "userTurnEvidenceDigest": { "$ref": "#/$defs/digest" },
        "postSendDeltaDigest": { "$ref": "#/$defs/digest" },
        "evidenceDigest": { "$ref": "#/$defs/digest" },
        "observedAt": { "$ref": "#/$defs/instant" }
      }
    },
    "targetEstablishment": {
      "allOf": [
        { "$ref": "#/$defs/targetEstablishmentRead" },
        { "type": "object", "required": ["postSendDeltaDigest"], "properties": { "postSendDeltaDigest": { "$ref": "#/$defs/digest" } } }
      ]
    },
    "submissionWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "actionId",
        "actionKind",
        "targetBindingDigest",
        "baselineSnapshotDigest",
        "postSendDeltaDigest",
        "operationUserEvidenceDigest",
        "observedAt"
      ],
      "properties": {
        "schemaVersion": { "const": "chatgpt.browser_control.operation_submission_witness.v1" },
        "actionId": { "$ref": "#/$defs/uuid" },
        "actionKind": { "enum": ["send", "work_steer"] },
        "targetBindingDigest": { "$ref": "#/$defs/digest" },
        "baselineSnapshotDigest": { "$ref": "#/$defs/digest" },
        "postSendDeltaDigest": { "$ref": "#/$defs/digest" },
        "operationUserEvidenceDigest": { "$ref": "#/$defs/digest" },
        "userTurnId": { "$ref": "#/$defs/opaqueId" },
        "observedAt": { "$ref": "#/$defs/instant" }
      }
    },
    "operationOwnershipBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "operationId", "requestDigest", "targetBindingDigest", "actionId", "baseline", "observedAt"],
      "properties": {
        "schemaVersion": { "const": "chatgpt.browser_control.operation_ownership_baseline.v1" },
        "operationId": { "$ref": "#/$defs/uuid" },
        "requestDigest": { "$ref": "#/$defs/digest" },
        "targetBindingDigest": { "$ref": "#/$defs/digest" },
        "actionId": { "$ref": "#/$defs/uuid" },
        "baseline": { "$ref": "#/$defs/ownershipBaseline" },
        "observedAt": { "$ref": "#/$defs/instant" }
      }
    },
    "ownershipBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "snapshotDigest", "target", "userTurns", "assistantTurns", "completeness"],
      "properties": {
        "schemaVersion": { "const": "chatgpt.browser_control.turn_ownership.v1" },
        "snapshotDigest": { "$ref": "#/$defs/digest" },
        "target": { "$ref": "#/$defs/ownershipTarget" },
        "userTurns": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/ownershipTurn" } },
        "assistantTurns": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/ownershipTurn" } },
        "completeness": { "const": "complete" }
      }
    },
    "ownershipTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "browser", "tab", "thread", "conversation", "canonicalThreadUrl", "authoritativeTabClaim", "coordinationScope"],
      "properties": {
        "provider": { "$ref": "#/$defs/ownershipIdentity" },
        "browser": { "$ref": "#/$defs/ownershipIdentity" },
        "tab": { "$ref": "#/$defs/ownershipIdentity" },
        "thread": { "$ref": "#/$defs/ownershipIdentity" },
        "conversation": { "$ref": "#/$defs/ownershipIdentity" },
        "canonicalThreadUrl": { "$ref": "#/$defs/ownershipUrlIdentity" },
        "authoritativeTabClaim": { "$ref": "#/$defs/ownershipIdentity" },
        "coordinationScope": { "enum": ["process", "provider"] }
      }
    },
    "ownershipIdentity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": { "status": { "const": "available" }, "value": { "$ref": "#/$defs/opaqueId" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": { "status": { "const": "unavailable" }, "reason": { "enum": ["not_exposed", "not_observed", "redacted"] } }
        }
      ]
    },
    "ownershipUrlIdentity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "available" },
            "value": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^https://[^?#]+$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": { "status": { "const": "unavailable" }, "reason": { "enum": ["not_exposed", "not_observed", "redacted"] } }
        }
      ]
    },
    "ownershipTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceDigest", "structureDigest", "ordinal"],
      "properties": {
        "stableId": { "$ref": "#/$defs/opaqueId" },
        "evidenceDigest": { "$ref": "#/$defs/digest" },
        "structureDigest": { "$ref": "#/$defs/digest" },
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "parentStableId": { "$ref": "#/$defs/opaqueId" },
        "branchStableId": { "$ref": "#/$defs/opaqueId" },
        "state": { "enum": ["generating", "terminal"] },
        "artifactEvidenceDigests": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/digest" } }
      }
    },
    "actionKind": {
      "enum": [
        "status_read",
        "configuration_set",
        "tool_set",
        "composer_set",
        "power_discovery",
        "power_select",
        "file_handoff",
        "send",
        "work_steer",
        "stop",
        "download",
        "local_output_commit",
        "clipboard_capture_restore"
      ]
    },
    "repeatPolicy": {
      "enum": [
        "read_only",
        "reconcile_set_to_value",
        "reconcile_local_effect",
        "observe_only_after_intent"
      ]
    },
    "actionIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "kind", "repeatPolicy", "requestDigest"],
      "properties": {
        "actionId": { "$ref": "#/$defs/uuid" },
        "kind": { "$ref": "#/$defs/actionKind" },
        "repeatPolicy": { "$ref": "#/$defs/repeatPolicy" },
        "requestDigest": { "$ref": "#/$defs/digest" },
        "parentActionId": { "$ref": "#/$defs/uuid" },
        "targetDigest": { "$ref": "#/$defs/digest" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "not": { "const": "status_read" } } }, "required": ["kind"] },
          "then": {
            "required": ["targetDigest"],
            "properties": { "targetDigest": { "$ref": "#/$defs/digest" } }
          }
        },
        {
          "if": { "properties": { "kind": { "enum": ["status_read", "power_discovery"] } }, "required": ["kind"] },
          "then": { "properties": { "repeatPolicy": { "const": "read_only" } } }
        },
        {
          "if": { "properties": { "kind": { "enum": ["configuration_set", "tool_set", "composer_set", "power_select"] } }, "required": ["kind"] },
          "then": { "properties": { "repeatPolicy": { "const": "reconcile_set_to_value" } } }
        },
        {
          "if": { "properties": { "kind": { "enum": ["file_handoff", "send", "work_steer", "stop"] } }, "required": ["kind"] },
          "then": { "properties": { "repeatPolicy": { "const": "observe_only_after_intent" } } }
        },
        {
          "if": { "properties": { "kind": { "enum": ["download", "local_output_commit", "clipboard_capture_restore"] } }, "required": ["kind"] },
          "then": { "properties": { "repeatPolicy": { "const": "reconcile_local_effect" } } }
        }
      ]
    },
    "actionPrepared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "action", "intentAt", "baseline"],
      "properties": {
        "type": { "const": "action_prepared" },
        "action": {
          "allOf": [
            { "$ref": "#/$defs/actionIntent" },
            {
              "type": "object",
              "required": ["kind"],
              "properties": { "kind": { "enum": ["send", "work_steer"] } }
            }
          ]
        },
        "intentAt": { "$ref": "#/$defs/instant" },
        "baseline": { "$ref": "#/$defs/operationOwnershipBaseline" }
      }
    },
    "artifactTransferIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "operationId", "requestDigest", "targetBindingDigest", "assistantTurnId",
        "sourceIdentityDigest", "kind", "ordinal", "transferActionId", "destinationIdentityDigest",
        "actionKind", "repeatPolicy", "intentAt"
      ],
      "properties": {
        "schemaVersion": { "const": "chatgpt.browser_control.artifact_transfer_intent.v1" },
        "operationId": { "$ref": "#/$defs/uuid" },
        "requestDigest": { "$ref": "#/$defs/digest" },
        "targetBindingDigest": { "$ref": "#/$defs/digest" },
        "assistantTurnId": { "$ref": "#/$defs/opaqueId" },
        "sourceIdentityDigest": { "$ref": "#/$defs/digest" },
        "kind": { "enum": ["file", "image", "other"] },
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "transferActionId": { "$ref": "#/$defs/uuid" },
        "destinationIdentityDigest": { "$ref": "#/$defs/digest" },
        "actionKind": { "const": "local_output_commit" },
        "repeatPolicy": { "const": "reconcile_local_effect" },
        "intentAt": { "$ref": "#/$defs/instant" }
      }
    },
    "artifactTransferReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "operationId", "requestDigest", "targetBindingDigest", "assistantTurnId",
        "sourceIdentityDigest", "kind", "ordinal", "transferActionId", "destinationIdentityDigest",
        "status", "observedAt"
      ],
      "properties": {
        "schemaVersion": { "const": "chatgpt.browser_control.artifact_transfer_receipt.v1" },
        "operationId": { "$ref": "#/$defs/uuid" },
        "requestDigest": { "$ref": "#/$defs/digest" },
        "targetBindingDigest": { "$ref": "#/$defs/digest" },
        "assistantTurnId": { "$ref": "#/$defs/opaqueId" },
        "sourceIdentityDigest": { "$ref": "#/$defs/digest" },
        "kind": { "enum": ["file", "image", "other"] },
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "transferActionId": { "$ref": "#/$defs/uuid" },
        "destinationIdentityDigest": { "$ref": "#/$defs/digest" },
        "outputKey": { "$ref": "#/$defs/outputKey" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["transferred", "partial", "blocked"] },
        "blockerCode": { "$ref": "#/$defs/code" },
        "observedAt": { "$ref": "#/$defs/instant" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "transferred" } }, "required": ["status"] },
          "then": {
            "required": ["outputKey", "bytes", "sha256"],
            "properties": {
              "outputKey": { "$ref": "#/$defs/outputKey" },
              "bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "sha256": { "$ref": "#/$defs/sha256" },
              "blockerCode": false
            }
          }
        },
        {
          "if": { "properties": { "status": { "enum": ["partial", "blocked"] } }, "required": ["status"] },
          "then": { "required": ["blockerCode"] }
        }
      ]
    },
    "actionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "actionId", "outcome", "observedAt"],
      "properties": {
        "type": { "const": "action_receipt" },
        "actionId": { "$ref": "#/$defs/uuid" },
        "outcome": { "enum": ["satisfied", "not_satisfied", "uncertain"] },
        "evidenceDigest": { "$ref": "#/$defs/digest" },
        "blockerCode": { "$ref": "#/$defs/code" },
        "observedAt": { "$ref": "#/$defs/instant" }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "satisfied" } }, "required": ["outcome"] },
          "then": {
            "required": ["evidenceDigest"],
            "properties": { "evidenceDigest": { "$ref": "#/$defs/digest" } }
          }
        },
        {
          "if": {
            "required": ["blockerCode"],
            "properties": { "blockerCode": { "$ref": "#/$defs/code" } }
          },
          "then": { "properties": { "outcome": { "enum": ["not_satisfied", "uncertain"] } } }
        }
      ]
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "messageDigest", "recoverable", "observedAt"],
      "properties": {
        "code": { "$ref": "#/$defs/code" },
        "messageDigest": { "$ref": "#/$defs/digest" },
        "recoverable": { "type": "boolean" },
        "observedAt": { "$ref": "#/$defs/instant" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "operationId", "artifactKey", "assistantTurnId", "sourceIdentityDigest", "kind", "ordinal", "status"],
      "properties": {
        "schemaVersion": { "const": "chatgpt.browser_control.operation_artifact_receipt.v1" },
        "operationId": { "$ref": "#/$defs/uuid" },
        "artifactKey": { "$ref": "#/$defs/opaqueKey" },
        "assistantTurnId": { "$ref": "#/$defs/opaqueId" },
        "sourceIdentityDigest": { "$ref": "#/$defs/digest" },
        "kind": { "enum": ["file", "image", "other"] },
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "outputKey": { "$ref": "#/$defs/outputKey" },
        "mimeType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 127,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+/-]{0,126}$"
        },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["available", "transferred", "partial", "blocked"] },
        "blockerCode": { "$ref": "#/$defs/code" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "transferred" } }, "required": ["status"] },
          "then": {
            "required": ["outputKey", "bytes", "sha256"],
            "properties": {
              "outputKey": { "$ref": "#/$defs/outputKey" },
              "bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "enum": ["partial", "blocked"] } }, "required": ["status"] },
          "then": {
            "required": ["blockerCode"],
            "properties": { "blockerCode": { "$ref": "#/$defs/code" } }
          }
        },
        {
          "if": { "properties": { "status": { "enum": ["available", "transferred"] } }, "required": ["status"] },
          "then": { "not": { "required": ["blockerCode"] } }
        }
      ]
    },
    "opaqueKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "outputKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "operationId",
        "requestDigest",
        "targetBindingDigest",
        "userTurnId",
        "userTurnEvidenceDigest",
        "assistantTurnId",
        "ownershipEvidenceDigest",
        "finishReason",
        "contentAvailable",
        "artifacts",
        "completedAt"
      ],
      "properties": {
        "schemaVersion": { "const": "chatgpt.browser_control.operation_receipt.v1" },
        "operationId": { "$ref": "#/$defs/uuid" },
        "requestDigest": { "$ref": "#/$defs/digest" },
        "targetBindingDigest": { "$ref": "#/$defs/digest" },
        "userTurnId": { "$ref": "#/$defs/opaqueId" },
        "userTurnEvidenceDigest": { "$ref": "#/$defs/digest" },
        "assistantTurnId": { "$ref": "#/$defs/opaqueId" },
        "ownershipEvidenceDigest": { "$ref": "#/$defs/digest" },
        "responseDigest": { "$ref": "#/$defs/digest" },
        "responseBytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "responseFormat": { "enum": ["markdown", "text"] },
        "finishReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "contentAvailable": { "type": "boolean" },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" },
          "maxItems": 32
        },
        "completedAt": { "$ref": "#/$defs/instant" }
      },
      "dependentRequired": {
        "responseDigest": ["responseBytes"],
        "responseBytes": ["responseDigest"]
      },
      "allOf": [
        {
          "if": { "properties": { "contentAvailable": { "const": true } }, "required": ["contentAvailable"] },
          "then": {
            "required": ["responseDigest", "responseBytes"],
            "properties": {
              "responseDigest": { "$ref": "#/$defs/digest" },
              "responseBytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
            }
          }
        }
      ]
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "operationId", "requestDigest", "surface", "createdAt"],
          "properties": {
            "type": { "const": "operation_created" },
            "operationId": { "$ref": "#/$defs/uuid" },
            "requestDigest": { "$ref": "#/$defs/digest" },
            "surface": { "enum": ["chat", "work"] },
            "createdAt": { "$ref": "#/$defs/instant" },
            "capturePolicy": { "$ref": "#/$defs/capturePolicy" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "target", "observedAt"],
          "properties": {
            "type": { "const": "target_bound" },
            "target": { "$ref": "#/$defs/target" },
            "observedAt": { "$ref": "#/$defs/instant" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "establishment"],
          "properties": {
            "type": { "const": "target_established" },
            "establishment": { "$ref": "#/$defs/targetEstablishment" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "witness"],
          "properties": {
            "type": { "const": "submission_witness" },
            "witness": { "$ref": "#/$defs/submissionWitness" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "baseline"],
          "properties": {
            "type": { "const": "ownership_baseline" },
            "baseline": { "$ref": "#/$defs/operationOwnershipBaseline" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "action", "intentAt"],
          "properties": {
            "type": { "const": "action_intent" },
            "action": { "$ref": "#/$defs/actionIntent" },
            "intentAt": { "$ref": "#/$defs/instant" }
          }
        },
        { "$ref": "#/$defs/actionPrepared" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "intent"],
          "properties": {
            "type": { "const": "artifact_transfer_intent" },
            "intent": { "$ref": "#/$defs/artifactTransferIntent" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "receipt"],
          "properties": {
            "type": { "const": "artifact_transfer_receipt" },
            "receipt": { "$ref": "#/$defs/artifactTransferReceipt" }
          }
        },
        { "$ref": "#/$defs/actionReceipt" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "from", "to", "mutationBoundary", "observedAt"],
          "properties": {
            "type": { "const": "phase_changed" },
            "from": { "$ref": "#/$defs/phase" },
            "to": { "$ref": "#/$defs/phase" },
            "mutationBoundary": { "$ref": "#/$defs/mutationBoundary" },
            "causeActionId": { "$ref": "#/$defs/uuid" },
            "evidenceDigest": { "$ref": "#/$defs/digest" },
            "observedAt": { "$ref": "#/$defs/instant" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "blocker"],
          "properties": {
            "type": { "const": "blocker_observed" },
            "blocker": { "$ref": "#/$defs/blocker" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "receipt", "observedAt"],
          "properties": {
            "type": { "const": "receipt_completed" },
            "receipt": { "$ref": "#/$defs/receipt" },
            "observedAt": { "$ref": "#/$defs/instant" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "available", "observedAt"],
          "properties": {
            "type": { "const": "content_availability_changed" },
            "available": { "type": "boolean" },
            "observedAt": { "$ref": "#/$defs/instant" }
          }
        }
      ]
    }
  }
}
