{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex-chatgpt-control/contracts/v1/capabilities.schema.json",
  "type": "object",
  "required": [
    "protocolVersion",
    "backendSessionId",
    "packageName",
    "packageVersion",
    "runtime",
    "runtimeVersion",
    "buildDigest",
    "supportedProtocolVersions",
    "commands",
    "transports",
    "streaming",
    "requestIds",
    "multiplexing",
    "cancellation",
    "tabs"
  ],
  "additionalProperties": false,
  "properties": {
    "protocolVersion": { "const": "chatgpt.browser_control.backend_request.v1" },
    "backendSessionId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "packageName": { "type": "string", "minLength": 1, "maxLength": 512 },
    "packageVersion": { "type": "string", "minLength": 1, "maxLength": 512 },
    "runtime": { "const": "node" },
    "runtimeVersion": { "type": "string", "minLength": 1, "maxLength": 512 },
    "buildDigest": { "type": "string", "minLength": 1, "maxLength": 512 },
    "supportedProtocolVersions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "transports": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["stdio", "http"] }
    },
    "streaming": {
      "type": "object",
      "required": ["modes", "tokenDeltas"],
      "additionalProperties": false,
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["ndjson", "sse"] }
        },
        "tokenDeltas": { "const": false }
      }
    },
    "requestIds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "scope"],
      "properties": {
        "required": { "type": "boolean" },
        "scope": { "enum": ["connection", "process", "none"] }
      }
    },
    "multiplexing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unary", "streams"],
      "properties": {
        "unary": { "type": "boolean" },
        "streams": { "type": "boolean" }
      }
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "requests", "streams"],
      "properties": {
        "supported": { "type": "boolean" },
        "requests": { "type": "boolean" },
        "streams": { "type": "boolean" }
      }
    },
    "tabs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stableProviderIdentity",
        "stableBrowserIdentity",
        "stableTabIdentity",
        "coordinationScope",
        "authoritativeClaim",
        "fencing",
        "concurrentTabs"
      ],
      "properties": {
        "stableProviderIdentity": { "type": "boolean" },
        "stableBrowserIdentity": { "type": "boolean" },
        "stableTabIdentity": { "type": "boolean" },
        "coordinationScope": { "enum": ["none", "process", "provider"] },
        "authoritativeClaim": { "type": "boolean" },
        "fencing": { "type": "boolean" },
        "concurrentTabs": { "type": "boolean" },
        "stableIdentity": { "type": "boolean" },
        "coordination": { "type": "boolean" },
        "concurrent": { "type": "boolean" }
      }
    }
  }
}
