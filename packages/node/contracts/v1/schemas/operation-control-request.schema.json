{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex-chatgpt-control/contracts/v1/schemas/operation-control-request.schema.json",
  "title": "Transactional browser operation control request",
  "description": "A request-only, caller-owned stop or steer action bound to an immutable parent handle and expected assistant turn. steerPrompt is transient and must not enter durable state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "controlActionId",
    "parent",
    "action",
    "expectedAssistantTurnId"
  ],
  "properties": {
    "schemaVersion": { "const": "chatgpt.browser_control.operation_control_request.v1" },
    "controlActionId": { "$ref": "#/$defs/uuid" },
    "parent": { "$ref": "#/$defs/handle" },
    "action": { "enum": ["stop", "steer"] },
    "expectedAssistantTurnId": { "$ref": "#/$defs/opaqueId" },
    "steerPrompt": { "type": "string", "minLength": 1, "maxLength": 8388608 },
    "timeoutMs": { "$ref": "#/$defs/timeoutMs" }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "steer" } }, "required": ["action"] },
      "then": {
        "required": ["steerPrompt"],
        "properties": { "steerPrompt": { "type": "string", "minLength": 1, "maxLength": 8388608 } }
      }
    },
    {
      "if": { "properties": { "action": { "const": "stop" } }, "required": ["action"] },
      "then": { "properties": { "steerPrompt": false } }
    },
    {
      "properties": {
        "parent": {
          "type": "object",
          "required": ["targetBindingDigest"],
          "properties": {
            "phase": { "const": "generating" },
            "targetBindingDigest": { "$ref": "#/$defs/digest" }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^hmac-sha256:[0-9a-f]{64}$"
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]{1,512}$"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "handle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "operationId",
        "requestDigest",
        "surface",
        "revision",
        "phase",
        "mutationBoundary"
      ],
      "properties": {
        "schemaVersion": { "const": "chatgpt.browser_control.operation_handle.v1" },
        "operationId": { "$ref": "#/$defs/uuid" },
        "requestDigest": { "$ref": "#/$defs/digest" },
        "surface": { "enum": ["chat", "work"] },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "phase": {
          "enum": [
            "prepared",
            "handoff_pending",
            "ready",
            "send_pending",
            "submitted",
            "generating",
            "capturing",
            "completed",
            "uncertain"
          ]
        },
        "mutationBoundary": {
          "enum": ["none", "handoff_may_have_occurred", "send_may_have_occurred", "control_may_have_occurred"]
        },
        "targetBindingDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
