{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex-chatgpt-control/contracts/v1/schemas/operation-handle.schema.json",
  "title": "Transactional browser operation handle",
  "description": "A locator and redacted receipt for a durable operation. It is not an authority token; callers must reload the journal and verify every binding before acting.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operationId",
    "requestDigest",
    "surface",
    "revision",
    "phase",
    "mutationBoundary"
  ],
  "properties": {
    "schemaVersion": { "const": "chatgpt.browser_control.operation_handle.v1" },
    "operationId": { "$ref": "#/$defs/uuid" },
    "requestDigest": { "$ref": "#/$defs/digest" },
    "surface": { "enum": ["chat", "work"] },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "phase": {
      "enum": [
        "prepared",
        "handoff_pending",
        "ready",
        "send_pending",
        "submitted",
        "generating",
        "capturing",
        "completed",
        "uncertain"
      ]
    },
    "mutationBoundary": {
      "enum": ["none", "handoff_may_have_occurred", "send_may_have_occurred", "control_may_have_occurred"]
    },
    "targetBindingDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^hmac-sha256:[0-9a-f]{64}$"
    }
  }
}
