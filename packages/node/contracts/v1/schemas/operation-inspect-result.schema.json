{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex-chatgpt-control/contracts/v1/schemas/operation-inspect-result.schema.json",
  "title": "Transactional browser operation inspect result",
  "description": "A browser-free durable inspection envelope. It always contains the fresh handle and a redacted materialized state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "operationId",
    "requestDigest",
    "handle",
    "state"
  ],
  "properties": {
    "schemaVersion": {
      "const": "chatgpt.browser_control.operation_inspect_result.v1"
    },
    "status": {
      "enum": [
        "completed",
        "pending",
        "uncertain"
      ]
    },
    "operationId": {
      "$ref": "#/$defs/uuid"
    },
    "requestDigest": {
      "$ref": "#/$defs/digest"
    },
    "handle": {
      "$ref": "#/$defs/handle"
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    }
  },
  "$defs": {
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "status", "mode", "warnings"],
      "properties": {
        "schemaVersion": {
          "const": "chatgpt.browser_control.backend_compatibility.v1"
        },
        "status": {
          "enum": ["compatible", "warning", "unknown", "blocked"]
        },
        "mode": {
          "enum": ["multiplexed", "single-flight", "legacy", "unknown"]
        },
        "protocolVersion": { "$ref": "#/$defs/compatibilityText" },
        "backendSessionId": { "$ref": "#/$defs/compatibilityText" },
        "packageName": { "$ref": "#/$defs/compatibilityText" },
        "packageVersion": { "$ref": "#/$defs/compatibilityText" },
        "runtime": { "$ref": "#/$defs/compatibilityText" },
        "runtimeVersion": { "$ref": "#/$defs/compatibilityText" },
        "buildDigest": { "$ref": "#/$defs/compatibilityText" },
        "warnings": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/compatibilityWarning" }
        }
      }
    },
    "compatibilityWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "package_name_mismatch",
            "package_version_mismatch",
            "runtime_mismatch",
            "runtime_version_mismatch",
            "build_digest_mismatch",
            "provenance_unknown",
            "legacy_backend",
            "negotiation_rejected"
          ]
        },
        "field": {
          "enum": ["packageName", "packageVersion", "runtime", "runtimeVersion", "buildDigest"]
        },
        "expected": { "$ref": "#/$defs/compatibilityText" },
        "received": { "$ref": "#/$defs/compatibilityText" },
        "message": { "$ref": "#/$defs/compatibilityText" }
      }
    },
    "compatibilityText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]{1,512}$"
    },
    "capturePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responseContent", "responseFormat", "artifacts"],
      "properties": {
        "responseContent": { "enum": ["include", "metadata"] },
        "responseFormat": { "enum": ["markdown", "text"] },
        "artifacts": { "enum": ["receipt_only", "transfer"] }
      }
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^hmac-sha256:[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "instant": {
      "type": "string",
      "pattern": "^(?!\\d{4}-02-(?:30|31)T)(?!\\d{4}-(?:04|06|09|11)-31T)\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]{1,512}$"
    },
    "phase": {
      "enum": [
        "prepared",
        "handoff_pending",
        "ready",
        "send_pending",
        "submitted",
        "generating",
        "capturing",
        "completed",
        "uncertain"
      ]
    },
    "boundary": {
      "enum": [
        "none",
        "handoff_may_have_occurred",
        "send_may_have_occurred",
        "control_may_have_occurred"
      ]
    },
    "handle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "operationId",
        "requestDigest",
        "surface",
        "revision",
        "phase",
        "mutationBoundary"
      ],
      "properties": {
        "schemaVersion": {
          "const": "chatgpt.browser_control.operation_handle.v1"
        },
        "operationId": {
          "$ref": "#/$defs/uuid"
        },
        "requestDigest": {
          "$ref": "#/$defs/digest"
        },
        "surface": {
          "enum": [
            "chat",
            "work"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "phase": {
          "$ref": "#/$defs/phase"
        },
        "mutationBoundary": {
          "$ref": "#/$defs/boundary"
        },
        "targetBindingDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "evidenceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerIdentity",
        "stableTabId",
        "stableConversationId",
        "stableUserTurnId",
        "authoritativeTabClaim",
        "replacementTabRecovery"
      ],
      "properties": {
        "providerIdentity": {
          "enum": [
            "required",
            "unavailable"
          ]
        },
        "stableTabId": {
          "enum": [
            "required",
            "unavailable"
          ]
        },
        "stableConversationId": {
          "enum": [
            "required",
            "unavailable"
          ]
        },
        "stableUserTurnId": {
          "enum": [
            "required",
            "unavailable"
          ]
        },
        "authoritativeTabClaim": {
          "enum": [
            "required",
            "unavailable"
          ]
        },
        "replacementTabRecovery": {
          "type": "boolean"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId",
        "browserId",
        "tabId",
        "coordinationScope",
        "evidenceProfile"
      ],
      "properties": {
        "providerId": {
          "$ref": "#/$defs/opaqueId"
        },
        "browserId": {
          "$ref": "#/$defs/opaqueId"
        },
        "tabId": {
          "$ref": "#/$defs/opaqueId"
        },
        "coordinationScope": {
          "enum": [
            "process",
            "provider"
          ]
        },
        "tabClaimEvidenceDigest": {
          "$ref": "#/$defs/digest"
        },
        "canonicalThreadUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^https://[^?#]+$"
        },
        "conversationId": {
          "$ref": "#/$defs/opaqueId"
        },
        "userTurnBaselineDigest": {
          "$ref": "#/$defs/digest"
        },
        "assistantTurnBaselineDigest": {
          "$ref": "#/$defs/digest"
        },
        "configurationReceiptDigest": {
          "$ref": "#/$defs/digest"
        },
        "targetLifecycle": {
          "enum": [
            "fixed",
            "new_pending",
            "new_established"
          ]
        },
        "newTargetAnchorDigest": {
          "$ref": "#/$defs/digest"
        },
        "blankTaskEvidenceDigest": {
          "$ref": "#/$defs/digest"
        },
        "targetEstablishment": {
          "$ref": "#/$defs/targetEstablishmentRead"
        },
        "evidenceProfile": {
          "$ref": "#/$defs/evidenceProfile"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "coordinationScope": {
                "const": "provider"
              }
            },
            "required": [
              "coordinationScope"
            ]
          },
          "then": {
            "required": [
              "tabClaimEvidenceDigest"
            ],
            "properties": {
              "tabClaimEvidenceDigest": {
                "$ref": "#/$defs/digest"
              },
              "evidenceProfile": {
                "type": "object",
                "properties": {
                  "authoritativeTabClaim": {
                    "const": "required"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "targetLifecycle": {
                "const": "new_pending"
              }
            },
            "required": [
              "targetLifecycle"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "newTargetAnchorDigest",
              "blankTaskEvidenceDigest"
            ],
            "properties": {
              "newTargetAnchorDigest": {
                "$ref": "#/$defs/digest"
              },
              "blankTaskEvidenceDigest": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "targetLifecycle": {
                "const": "new_established"
              }
            },
            "required": [
              "targetLifecycle"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "newTargetAnchorDigest",
              "blankTaskEvidenceDigest",
              "canonicalThreadUrl",
              "conversationId",
              "targetEstablishment"
            ],
            "properties": {
              "newTargetAnchorDigest": {
                "$ref": "#/$defs/digest"
              },
              "blankTaskEvidenceDigest": {
                "$ref": "#/$defs/digest"
              },
              "canonicalThreadUrl": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^https://[^?#]+$"
              },
              "conversationId": {
                "$ref": "#/$defs/opaqueId"
              },
              "targetEstablishment": {
                "$ref": "#/$defs/targetEstablishment"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "targetLifecycle": {
                "const": "fixed"
              }
            },
            "required": [
              "targetLifecycle"
            ]
          },
          "then": {
            "type": "object"
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionId",
        "kind",
        "repeatPolicy",
        "requestDigest",
        "intentRevision",
        "intentAt"
      ],
      "properties": {
        "actionId": {
          "$ref": "#/$defs/uuid"
        },
        "kind": {
          "$ref": "#/$defs/actionKind"
        },
        "repeatPolicy": {
          "$ref": "#/$defs/repeatPolicy"
        },
        "requestDigest": {
          "$ref": "#/$defs/digest"
        },
        "parentActionId": {
          "$ref": "#/$defs/uuid"
        },
        "targetDigest": {
          "$ref": "#/$defs/digest"
        },
        "intentRevision": {
          "$ref": "#/$defs/revision"
        },
        "intentAt": {
          "$ref": "#/$defs/instant"
        },
        "outcome": {
          "enum": [
            "satisfied",
            "not_satisfied",
            "uncertain"
          ]
        },
        "receiptRevision": {
          "$ref": "#/$defs/revision"
        },
        "receiptAt": {
          "$ref": "#/$defs/instant"
        },
        "evidenceDigest": {
          "$ref": "#/$defs/digest"
        },
        "blockerCode": {
          "$ref": "#/$defs/code"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "outcome"
            ],
            "properties": {
              "outcome": {
                "enum": [
                  "satisfied",
                  "not_satisfied",
                  "uncertain"
                ]
              }
            }
          },
          "then": {
            "required": [
              "receiptRevision",
              "receiptAt"
            ],
            "properties": {
              "receiptRevision": {
                "$ref": "#/$defs/revision"
              },
              "receiptAt": {
                "$ref": "#/$defs/instant"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "receiptRevision"
            ],
            "properties": {
              "receiptRevision": {
                "$ref": "#/$defs/revision"
              }
            }
          },
          "then": {
            "required": [
              "outcome",
              "receiptAt"
            ],
            "properties": {
              "outcome": {
                "enum": [
                  "satisfied",
                  "not_satisfied",
                  "uncertain"
                ]
              },
              "receiptAt": {
                "$ref": "#/$defs/instant"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "receiptAt"
            ]
          },
          "then": {
            "required": [
              "outcome",
              "receiptRevision"
            ],
            "properties": {
              "outcome": {
                "enum": [
                  "satisfied",
                  "not_satisfied",
                  "uncertain"
                ]
              },
              "receiptRevision": {
                "$ref": "#/$defs/revision"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "evidenceDigest"
            ],
            "properties": {
              "evidenceDigest": {
                "$ref": "#/$defs/digest"
              }
            }
          },
          "then": {
            "required": [
              "outcome"
            ],
            "properties": {
              "outcome": {
                "enum": [
                  "satisfied",
                  "not_satisfied",
                  "uncertain"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "blockerCode"
            ],
            "properties": {
              "blockerCode": {
                "$ref": "#/$defs/code"
              }
            }
          },
          "then": {
            "required": [
              "outcome"
            ],
            "properties": {
              "outcome": {
                "enum": [
                  "not_satisfied",
                  "uncertain"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "satisfied"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "required": [
              "evidenceDigest"
            ],
            "properties": {
              "evidenceDigest": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "not": {
                  "const": "status_read"
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "targetDigest"
            ],
            "properties": {
              "targetDigest": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "status_read",
                  "power_discovery"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "repeatPolicy": {
                "const": "read_only"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "configuration_set",
                  "tool_set",
                  "composer_set",
                  "power_select"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "repeatPolicy": {
                "const": "reconcile_set_to_value"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "file_handoff",
                  "send",
                  "work_steer",
                  "stop"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "repeatPolicy": {
                "const": "observe_only_after_intent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "download",
                  "local_output_commit",
                  "clipboard_capture_restore"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "repeatPolicy": {
                "const": "reconcile_local_effect"
              }
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "operationId",
        "artifactKey",
        "assistantTurnId",
        "sourceIdentityDigest",
        "kind",
        "ordinal",
        "status"
      ],
      "properties": {
        "schemaVersion": {
          "const": "chatgpt.browser_control.operation_artifact_receipt.v1"
        },
        "operationId": {
          "$ref": "#/$defs/uuid"
        },
        "artifactKey": {
          "$ref": "#/$defs/opaqueKey"
        },
        "assistantTurnId": {
          "$ref": "#/$defs/opaqueId"
        },
        "sourceIdentityDigest": {
          "$ref": "#/$defs/digest"
        },
        "kind": {
          "enum": [
            "file",
            "image",
            "other"
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputKey": {
          "$ref": "#/$defs/outputKey"
        },
        "mimeType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 127,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+/-]{0,126}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "available",
            "transferred",
            "partial",
            "blocked"
          ]
        },
        "blockerCode": {
          "$ref": "#/$defs/code"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "transferred"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "outputKey",
              "bytes",
              "sha256"
            ],
            "properties": {
              "outputKey": {
                "$ref": "#/$defs/outputKey"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "partial",
                  "blocked"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "blockerCode"
            ],
            "properties": {
              "blockerCode": {
                "$ref": "#/$defs/code"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "available",
                  "transferred"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "required": [
                "blockerCode"
              ]
            }
          }
        }
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "operationId",
        "requestDigest",
        "targetBindingDigest",
        "userTurnId",
        "userTurnEvidenceDigest",
        "assistantTurnId",
        "ownershipEvidenceDigest",
        "finishReason",
        "contentAvailable",
        "artifacts",
        "completedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "chatgpt.browser_control.operation_receipt.v1"
        },
        "operationId": {
          "$ref": "#/$defs/uuid"
        },
        "requestDigest": {
          "$ref": "#/$defs/digest"
        },
        "targetBindingDigest": {
          "$ref": "#/$defs/digest"
        },
        "userTurnId": {
          "$ref": "#/$defs/opaqueId"
        },
        "userTurnEvidenceDigest": {
          "$ref": "#/$defs/digest"
        },
        "assistantTurnId": {
          "$ref": "#/$defs/opaqueId"
        },
        "ownershipEvidenceDigest": {
          "$ref": "#/$defs/digest"
        },
        "responseDigest": {
          "$ref": "#/$defs/digest"
        },
        "responseBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "responseFormat": {
          "enum": [
            "markdown",
            "text"
          ]
        },
        "finishReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "contentAvailable": {
          "type": "boolean"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "maxItems": 32
        },
        "completedAt": {
          "$ref": "#/$defs/instant"
        }
      },
      "dependentRequired": {
        "responseDigest": [
          "responseBytes"
        ],
        "responseBytes": [
          "responseDigest"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "contentAvailable": {
                "const": true
              }
            },
            "required": [
              "contentAvailable"
            ]
          },
          "then": {
            "required": [
              "responseDigest",
              "responseBytes"
            ],
            "properties": {
              "responseDigest": {
                "$ref": "#/$defs/digest"
              },
              "responseBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        }
      ]
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "messageDigest",
        "recoverable",
        "observedAt"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "messageDigest": {
          "$ref": "#/$defs/digest"
        },
        "recoverable": {
          "type": "boolean"
        },
        "observedAt": {
          "$ref": "#/$defs/instant"
        }
      }
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "operationId",
        "requestDigest",
        "surface",
        "phase",
        "mutationBoundary",
        "revision",
        "createdAt",
        "updatedAt",
        "actions"
      ],
      "properties": {
        "schemaVersion": {
          "const": "chatgpt.browser_control.operation.v1"
        },
        "operationId": {
          "$ref": "#/$defs/uuid"
        },
        "requestDigest": {
          "$ref": "#/$defs/digest"
        },
        "surface": {
          "enum": [
            "chat",
            "work"
          ]
        },
        "phase": {
          "$ref": "#/$defs/phase"
        },
        "mutationBoundary": {
          "$ref": "#/$defs/mutationBoundary"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "createdAt": {
          "$ref": "#/$defs/instant"
        },
        "updatedAt": {
          "$ref": "#/$defs/instant"
        },
        "capturePolicy": {
          "$ref": "#/$defs/capturePolicy"
        },
        "responseFormat": {
          "enum": [
            "markdown",
            "text"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "actions": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/uuid"
          },
          "additionalProperties": {
            "$ref": "#/$defs/action"
          }
        },
        "ownershipBaseline": {
          "$ref": "#/$defs/operationOwnershipBaseline"
        },
        "ownershipBaselines": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/uuid"
          },
          "maxProperties": 64,
          "additionalProperties": {
            "$ref": "#/$defs/operationOwnershipBaseline"
          }
        },
        "artifactTransfers": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/uuid"
          },
          "additionalProperties": {
            "$ref": "#/$defs/artifactTransferState"
          }
        },
        "submissionWitnesses": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/uuid"
          },
          "maxProperties": 64,
          "additionalProperties": {
            "$ref": "#/$defs/submissionWitness"
          }
        },
        "submissionWitness": {
          "$ref": "#/$defs/submissionWitness"
        },
        "lastBlocker": {
          "$ref": "#/$defs/blocker"
        },
        "receipt": {
          "$ref": "#/$defs/receipt"
        }
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "mutationBoundary": {
      "enum": [
        "none",
        "handoff_may_have_occurred",
        "send_may_have_occurred",
        "control_may_have_occurred"
      ]
    },
    "targetEstablishmentRead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetBindingDigest",
        "anchorDigest",
        "causalSendActionId",
        "conversationId",
        "canonicalThreadUrl",
        "userTurnId",
        "userTurnEvidenceDigest",
        "evidenceDigest",
        "observedAt"
      ],
      "properties": {
        "targetBindingDigest": {
          "$ref": "#/$defs/digest"
        },
        "anchorDigest": {
          "$ref": "#/$defs/digest"
        },
        "causalSendActionId": {
          "$ref": "#/$defs/uuid"
        },
        "conversationId": {
          "$ref": "#/$defs/opaqueId"
        },
        "canonicalThreadUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^https://[^?#]+$"
        },
        "userTurnId": {
          "$ref": "#/$defs/opaqueId"
        },
        "userTurnEvidenceDigest": {
          "$ref": "#/$defs/digest"
        },
        "postSendDeltaDigest": {
          "$ref": "#/$defs/digest"
        },
        "evidenceDigest": {
          "$ref": "#/$defs/digest"
        },
        "observedAt": {
          "$ref": "#/$defs/instant"
        }
      }
    },
    "targetEstablishment": {
      "allOf": [
        {
          "$ref": "#/$defs/targetEstablishmentRead"
        },
        {
          "type": "object",
          "required": [
            "postSendDeltaDigest"
          ],
          "properties": {
            "postSendDeltaDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      ]
    },
    "submissionWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "actionId",
        "actionKind",
        "targetBindingDigest",
        "baselineSnapshotDigest",
        "postSendDeltaDigest",
        "operationUserEvidenceDigest",
        "observedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "chatgpt.browser_control.operation_submission_witness.v1"
        },
        "actionId": {
          "$ref": "#/$defs/uuid"
        },
        "actionKind": {
          "enum": [
            "send",
            "work_steer"
          ]
        },
        "targetBindingDigest": {
          "$ref": "#/$defs/digest"
        },
        "baselineSnapshotDigest": {
          "$ref": "#/$defs/digest"
        },
        "postSendDeltaDigest": {
          "$ref": "#/$defs/digest"
        },
        "operationUserEvidenceDigest": {
          "$ref": "#/$defs/digest"
        },
        "userTurnId": {
          "$ref": "#/$defs/opaqueId"
        },
        "observedAt": {
          "$ref": "#/$defs/instant"
        }
      }
    },
    "operationOwnershipBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "operationId",
        "requestDigest",
        "targetBindingDigest",
        "actionId",
        "baseline",
        "observedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "chatgpt.browser_control.operation_ownership_baseline.v1"
        },
        "operationId": {
          "$ref": "#/$defs/uuid"
        },
        "requestDigest": {
          "$ref": "#/$defs/digest"
        },
        "targetBindingDigest": {
          "$ref": "#/$defs/digest"
        },
        "actionId": {
          "$ref": "#/$defs/uuid"
        },
        "baseline": {
          "$ref": "#/$defs/ownershipBaseline"
        },
        "observedAt": {
          "$ref": "#/$defs/instant"
        }
      }
    },
    "ownershipBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "snapshotDigest",
        "target",
        "userTurns",
        "assistantTurns",
        "completeness"
      ],
      "properties": {
        "schemaVersion": {
          "const": "chatgpt.browser_control.turn_ownership.v1"
        },
        "snapshotDigest": {
          "$ref": "#/$defs/digest"
        },
        "target": {
          "$ref": "#/$defs/ownershipTarget"
        },
        "userTurns": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/ownershipTurn"
          }
        },
        "assistantTurns": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/ownershipTurn"
          }
        },
        "completeness": {
          "const": "complete"
        }
      }
    },
    "artifactTransferState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent"],
      "properties": {
        "intent": { "$ref": "#/$defs/artifactTransferIntent" },
        "receipt": { "$ref": "#/$defs/artifactTransferReceipt" }
      }
    },
    "artifactTransferIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "operationId", "requestDigest", "targetBindingDigest", "assistantTurnId",
        "sourceIdentityDigest", "kind", "ordinal", "transferActionId", "destinationIdentityDigest",
        "actionKind", "repeatPolicy", "intentAt"
      ],
      "properties": {
        "schemaVersion": { "const": "chatgpt.browser_control.artifact_transfer_intent.v1" },
        "operationId": { "$ref": "#/$defs/uuid" },
        "requestDigest": { "$ref": "#/$defs/digest" },
        "targetBindingDigest": { "$ref": "#/$defs/digest" },
        "assistantTurnId": { "$ref": "#/$defs/opaqueId" },
        "sourceIdentityDigest": { "$ref": "#/$defs/digest" },
        "kind": { "enum": ["file", "image", "other"] },
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "transferActionId": { "$ref": "#/$defs/uuid" },
        "destinationIdentityDigest": { "$ref": "#/$defs/digest" },
        "actionKind": { "const": "local_output_commit" },
        "repeatPolicy": { "const": "reconcile_local_effect" },
        "intentAt": { "$ref": "#/$defs/instant" }
      }
    },
    "artifactTransferReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "operationId", "requestDigest", "targetBindingDigest", "assistantTurnId",
        "sourceIdentityDigest", "kind", "ordinal", "transferActionId", "destinationIdentityDigest",
        "status", "observedAt"
      ],
      "properties": {
        "schemaVersion": { "const": "chatgpt.browser_control.artifact_transfer_receipt.v1" },
        "operationId": { "$ref": "#/$defs/uuid" },
        "requestDigest": { "$ref": "#/$defs/digest" },
        "targetBindingDigest": { "$ref": "#/$defs/digest" },
        "assistantTurnId": { "$ref": "#/$defs/opaqueId" },
        "sourceIdentityDigest": { "$ref": "#/$defs/digest" },
        "kind": { "enum": ["file", "image", "other"] },
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "transferActionId": { "$ref": "#/$defs/uuid" },
        "destinationIdentityDigest": { "$ref": "#/$defs/digest" },
        "outputKey": { "$ref": "#/$defs/outputKey" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["transferred", "partial", "blocked"] },
        "blockerCode": { "$ref": "#/$defs/code" },
        "observedAt": { "$ref": "#/$defs/instant" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "transferred" } }, "required": ["status"] },
          "then": {
            "required": ["outputKey", "bytes", "sha256"],
            "properties": {
              "outputKey": { "$ref": "#/$defs/outputKey" },
              "bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "sha256": { "$ref": "#/$defs/sha256" },
              "blockerCode": false
            }
          }
        },
        {
          "if": { "properties": { "status": { "enum": ["partial", "blocked"] } }, "required": ["status"] },
          "then": { "required": ["blockerCode"] }
        }
      ]
    },
    "ownershipTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "browser",
        "tab",
        "thread",
        "conversation",
        "canonicalThreadUrl",
        "authoritativeTabClaim",
        "coordinationScope"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/ownershipIdentity"
        },
        "browser": {
          "$ref": "#/$defs/ownershipIdentity"
        },
        "tab": {
          "$ref": "#/$defs/ownershipIdentity"
        },
        "thread": {
          "$ref": "#/$defs/ownershipIdentity"
        },
        "conversation": {
          "$ref": "#/$defs/ownershipIdentity"
        },
        "canonicalThreadUrl": {
          "$ref": "#/$defs/ownershipUrlIdentity"
        },
        "authoritativeTabClaim": {
          "$ref": "#/$defs/ownershipIdentity"
        },
        "coordinationScope": {
          "enum": [
            "process",
            "provider"
          ]
        }
      }
    },
    "ownershipIdentity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value"
          ],
          "properties": {
            "status": {
              "const": "available"
            },
            "value": {
              "$ref": "#/$defs/opaqueId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "enum": [
                "not_exposed",
                "not_observed",
                "redacted"
              ]
            }
          }
        }
      ]
    },
    "ownershipUrlIdentity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value"
          ],
          "properties": {
            "status": {
              "const": "available"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^https://[^?#]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "enum": [
                "not_exposed",
                "not_observed",
                "redacted"
              ]
            }
          }
        }
      ]
    },
    "ownershipTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceDigest",
        "structureDigest",
        "ordinal"
      ],
      "properties": {
        "stableId": {
          "$ref": "#/$defs/opaqueId"
        },
        "evidenceDigest": {
          "$ref": "#/$defs/digest"
        },
        "structureDigest": {
          "$ref": "#/$defs/digest"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "parentStableId": {
          "$ref": "#/$defs/opaqueId"
        },
        "branchStableId": {
          "$ref": "#/$defs/opaqueId"
        },
        "state": {
          "enum": [
            "generating",
            "terminal"
          ]
        },
        "artifactEvidenceDigests": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "actionKind": {
      "enum": [
        "status_read",
        "configuration_set",
        "tool_set",
        "composer_set",
        "power_discovery",
        "power_select",
        "file_handoff",
        "send",
        "work_steer",
        "stop",
        "download",
        "local_output_commit",
        "clipboard_capture_restore"
      ]
    },
    "repeatPolicy": {
      "enum": [
        "read_only",
        "reconcile_set_to_value",
        "reconcile_local_effect",
        "observe_only_after_intent"
      ]
    },
    "opaqueKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "outputKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  }
}
