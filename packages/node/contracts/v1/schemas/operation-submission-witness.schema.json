{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex-chatgpt-control/contracts/v1/schemas/operation-submission-witness.schema.json",
  "title": "Transactional browser operation submission witness",
  "description": "A redacted immutable proof binding the sole Send or Work steer intent to the exact post-Send user-turn evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "actionId",
    "actionKind",
    "targetBindingDigest",
    "baselineSnapshotDigest",
    "postSendDeltaDigest",
    "operationUserEvidenceDigest",
    "observedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "chatgpt.browser_control.operation_submission_witness.v1" },
    "actionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "actionKind": { "enum": ["send", "work_steer"] },
    "targetBindingDigest": { "$ref": "#/$defs/digest" },
    "baselineSnapshotDigest": { "$ref": "#/$defs/digest" },
    "postSendDeltaDigest": { "$ref": "#/$defs/digest" },
    "operationUserEvidenceDigest": { "$ref": "#/$defs/digest" },
    "userTurnId": { "$ref": "#/$defs/opaqueId" },
    "observedAt": { "$ref": "#/$defs/instant" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^hmac-sha256:[0-9a-f]{64}$"
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]{1,512}$"
    },
    "instant": {
      "type": "string",
      "pattern": "^(?!\\d{4}-02-(?:30|31)T)(?!\\d{4}-(?:04|06|09|11)-31T)\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
    }
  }
}
