{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex-chatgpt-control/contracts/v1/schemas/operation-request.schema.json",
  "title": "Transactional browser operation submit request",
  "description": "The request-only submit shape. prompt, input file paths, display names, and outputDirectory are accepted transient inputs and must not be copied into durable operation state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operationId", "surface", "prompt", "target"],
  "properties": {
    "schemaVersion": { "const": "chatgpt.browser_control.operation_request.v1" },
    "operationId": { "$ref": "#/$defs/uuid" },
    "surface": { "enum": ["chat", "work"] },
    "prompt": { "type": "string", "maxLength": 8388608 },
    "target": { "$ref": "#/$defs/targetRequest" },
    "configuration": { "$ref": "#/$defs/configuration" },
    "files": {
      "type": "array",
      "items": { "$ref": "#/$defs/inputFile" },
      "maxItems": 256
    },
    "capture": { "$ref": "#/$defs/capture" },
    "timeoutMs": { "$ref": "#/$defs/timeoutMs" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "targetRequest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "new" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name"],
          "properties": {
            "type": { "const": "project" },
            "name": { "type": "string", "minLength": 1, "maxLength": 512 },
            "icon": {
              "enum": [
                "Folder", "Currency Dollar", "Book", "Graduation Cap", "Pencil", "Writing",
                "Code Brackets", "Terminal", "Music", "Popcorn", "Customize", "Palette",
                "Stethoscope", "Health", "Lotus", "Suitcase", "Bar Chart", "Kettlebell",
                "Dumbbell", "Logs", "Balancing Scale", "Globe Spin", "Plane", "Globe",
                "Wrench", "Paw", "Flask", "Brain", "Heart", "Plant"
              ]
            },
            "color": { "enum": ["default", "red", "orange", "yellow", "green", "blue", "purple", "pink"] },
            "confirmCreation": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "selected_tab" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "tabId"],
          "properties": {
            "type": { "const": "tab_id" },
            "tabId": { "$ref": "#/$defs/opaqueId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "conversationId"],
          "properties": {
            "type": { "const": "conversation_id" },
            "conversationId": { "$ref": "#/$defs/opaqueId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "url"],
          "properties": {
            "type": { "const": "url" },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^https?://[^\\u0000-\\u001f\\u007f]+$"
            }
          }
        }
      ]
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "experience": { "enum": ["chat", "work"] },
        "model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "modelVersion": { "type": "string", "minLength": 1, "maxLength": 256 },
        "reasoning": { "type": "string", "minLength": 1, "maxLength": 256 },
        "mode": { "type": "string", "minLength": 1, "maxLength": 256 },
        "tools": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 256 },
          "maxItems": 256
        },
        "additional": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      }
    },
    "inputFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responseContent", "artifacts"],
      "properties": {
        "responseContent": { "enum": ["include", "metadata"] },
        "responseFormat": { "enum": ["markdown", "text"] },
        "artifacts": { "enum": ["receipt_only", "transfer"] },
        "outputDirectory": { "type": "string", "minLength": 1, "maxLength": 4096 }
      },
      "allOf": [
        {
          "if": { "properties": { "artifacts": { "const": "transfer" } }, "required": ["artifacts"] },
          "then": {
            "required": ["outputDirectory"],
            "properties": { "outputDirectory": { "type": "string", "minLength": 1, "maxLength": 4096 } }
          }
        },
        {
          "if": { "properties": { "artifacts": { "const": "receipt_only" } }, "required": ["artifacts"] },
          "then": { "properties": { "outputDirectory": false } }
        }
      ]
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]{1,512}$"
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    }
  }
}
